<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oussama Benjaa — Infographiste &amp; Graphiste Food/Branding</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --navy-950:#080D17;
  --navy-900:#0B1424;
  --navy-800:#101B30;
  --navy-700:#16233c;
  --gold-500:#F0A93B;
  --gold-400:#F5BE5F;
  --gold-700:#C97F16;
  --ink-100:#E9EDF5;
  --ink-300:#AEB8CC;
  --ink-500:#7B87A3;
  --line:rgba(240,169,59,.14);
  --line-strong:rgba(240,169,59,.35);
  --radius:2px;
  --disp:'Anton', sans-serif;
  --util:'Space Grotesk', sans-serif;
  --body:'Inter', sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--navy-950);
  color:var(--ink-100);
  font-family:var(--body);
  overflow-x:hidden;
  cursor:none;
}
@media (max-width:900px){ body{cursor:auto;} }
::selection{background:var(--gold-500);color:var(--navy-950);}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
section{position:relative;padding:140px 0;}
@media (max-width:700px){ section{padding:90px 0;} .wrap{padding:0 20px;} }

/* eyebrow / labels */
.eyebrow{
  font-family:var(--util);
  font-size:12.5px;
  letter-spacing:.32em;
  text-transform:uppercase;
  color:var(--gold-500);
  display:flex;align-items:center;gap:14px;
  margin-bottom:22px;
}
.eyebrow::before{
  content:"";width:34px;height:1px;background:var(--gold-500);
}
h2.section-title{
  font-family:var(--disp);
  font-weight:400;
  font-size:clamp(34px,5vw,58px);
  line-height:1.02;
  letter-spacing:.01em;
  text-transform:uppercase;
  margin-bottom:20px;
}
.section-sub{
  color:var(--ink-300);
  font-size:16px;
  max-width:560px;
  line-height:1.7;
}

/* ============ LOADER ============ */
#loader{
  position:fixed;inset:0;background:var(--navy-950);z-index:9999;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  transition:opacity .6s ease, visibility .6s ease;
}
#loader.hide{opacity:0;visibility:hidden;}
.loader-mark{
  font-family:var(--disp);font-size:54px;color:var(--gold-500);letter-spacing:.05em;
  display:flex;gap:2px;
}
.loader-mark span{opacity:0;transform:translateY(14px);animation:loadIn .5s forwards;}
.loader-mark span:nth-child(2){animation-delay:.08s;}
.loader-bar{
  width:220px;height:1px;background:var(--navy-700);margin-top:26px;position:relative;overflow:hidden;
}
.loader-bar i{
  position:absolute;left:0;top:0;height:100%;width:0%;background:var(--gold-500);
}
.loader-pct{font-family:var(--util);font-size:11px;letter-spacing:.25em;color:var(--ink-500);margin-top:14px;}
@keyframes loadIn{to{opacity:1;transform:translateY(0);}}

/* ============ CURSOR ============ */
#cursor-dot,#cursor-ring{
  position:fixed;top:0;left:0;pointer-events:none;z-index:9998;
  border-radius:50%;transform:translate(-50%,-50%);
}
#cursor-dot{width:6px;height:6px;background:var(--gold-500);}
#cursor-ring{
  width:34px;height:34px;border:1px solid var(--line-strong);
  transition:width .25s,height .25s,border-color .25s,background .25s;
}
#cursor-ring.hover{width:56px;height:56px;background:rgba(240,169,59,.08);border-color:var(--gold-500);}
@media (max-width:900px){ #cursor-dot,#cursor-ring{display:none;} }

/* ============ SCROLL PROGRESS BLADE ============ */
#blade{
  position:fixed;left:0;top:0;bottom:0;width:3px;z-index:500;
  background:linear-gradient(var(--navy-700),var(--navy-700));
}
#blade i{
  display:block;width:100%;height:0%;
  background:linear-gradient(var(--gold-700),var(--gold-500));
  box-shadow:0 0 12px rgba(240,169,59,.6);
}
@media (max-width:900px){ #blade{display:none;} }

@media (max-width:480px){
  .hero-eyebrow{font-size:11px;letter-spacing:.24em;}
  .hero-tagline{font-size:14.5px;}
  .hero-actions{gap:12px;}
  .btn{padding:13px 20px;font-size:12px;}
  .float-icon{font-size:10.5px;padding:7px 10px;gap:6px;}
  .float-icon svg{width:13px;height:13px;}
  .fi-1{left:-2%;top:2%;}
  .fi-2{right:-4%;bottom:10%;}
  .fi-3{left:4%;bottom:-6%;}
  .hero-photo{width:70%;}
  .hero-ring{width:104%;height:104%;}
  .about-photo .tag{font-size:10.5px;padding:10px 14px;bottom:-10px;right:-10px;}
  .quick-facts{grid-template-columns:1fr;gap:14px;}
  .gallery-grid{grid-template-columns:repeat(2,1fr);gap:8px;}
  .gallery-grid img{height:110px;}
  .gallery-grid figcaption{font-size:9.5px;padding:6px 8px;}
  .detail-inner{padding:26px 20px;}
  .project-info{padding:30px 24px;}
  .palette{gap:6px;}
  .swatch{width:52px;height:52px;font-size:8.5px;}
  .timeline{padding-left:26px;}
  .tl-item::before{left:-32px;}
  .stats-grid{gap:32px 0;}
  .edu-grid, .services-grid{grid-template-columns:1fr;}
  .soft-card{min-width:88px;padding:14px 16px;}
  .contact-item svg{width:17px;height:17px;}
}

/* ============ NAV ============ */
header{
  position:fixed;top:0;left:0;right:0;z-index:400;
  padding:22px 0;
  background:linear-gradient(rgba(8,13,23,.92),rgba(8,13,23,.75));
  backdrop-filter:blur(6px);
  border-bottom:1px solid transparent;
  transition:border-color .3s, padding .3s;
}
header.scrolled{border-color:var(--line);padding:14px 0;}
nav{display:flex;align-items:center;justify-content:space-between;padding-left:32px;padding-right:32px;max-width:1180px;margin:0 auto;}
.logo{font-family:var(--util);font-weight:700;font-size:18px;letter-spacing:.04em;}
.logo b{color:var(--gold-500);font-weight:700;}
.navlinks{display:flex;gap:38px;font-family:var(--util);font-size:13px;letter-spacing:.08em;text-transform:uppercase;}
.navlinks a{position:relative;color:var(--ink-300);transition:color .25s;}
.navlinks a::after{content:"";position:absolute;left:0;bottom:-6px;width:0;height:1px;background:var(--gold-500);transition:width .25s;}
.navlinks a:hover{color:var(--ink-100);}
.navlinks a:hover::after{width:100%;}
.nav-cta{
  font-family:var(--util);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;
  border:1px solid var(--line-strong);padding:10px 20px;color:var(--gold-500);
  transition:background .25s,color .25s;
}
.nav-cta:hover{background:var(--gold-500);color:var(--navy-950);}
.burger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
.burger span{width:24px;height:2px;background:var(--ink-100);}
@media (max-width:860px){
  .navlinks{position:fixed;top:0;right:-100%;height:100vh;width:70%;max-width:320px;
    background:var(--navy-900);flex-direction:column;justify-content:center;align-items:flex-start;
    padding:40px;transition:right .4s ease;gap:26px;z-index:399;}
  .navlinks.open{right:0;}
  .nav-cta{display:none;}
  .burger{display:flex;}
}

/* ============ HERO ============ */
#hero{
  min-height:100vh;display:flex;align-items:center;position:relative;
  padding-top:120px;overflow:hidden;
}
.blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.35;z-index:0;}
.blob-a{width:520px;height:520px;background:var(--gold-700);top:-160px;right:-140px;}
.blob-b{width:420px;height:420px;background:var(--navy-700);bottom:-140px;left:-120px;}
.hero-grid{display:grid;grid-template-columns:1.3fr .8fr;gap:60px;align-items:center;position:relative;z-index:2;}
@media (max-width:900px){ .hero-grid{grid-template-columns:1fr;} }
.hero-eyebrow{font-family:var(--util);letter-spacing:.3em;font-size:12px;color:var(--gold-500);text-transform:uppercase;margin-bottom:18px;}
h1.hero-name{
  font-family:var(--disp);font-weight:400;text-transform:uppercase;
  font-size:clamp(48px,8vw,104px);line-height:.92;letter-spacing:.01em;
}
h1.hero-name .last{
  background:linear-gradient(100deg,var(--gold-400),var(--gold-700));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  display:block;
}
.hero-role{
  font-family:var(--util);font-size:clamp(16px,2vw,22px);color:var(--ink-300);
  margin-top:22px;min-height:32px;
}
.hero-role .typed-cursor{color:var(--gold-500);}
.hero-tagline{
  margin-top:22px;max-width:480px;color:var(--ink-300);line-height:1.75;font-size:15.5px;
}
.hero-actions{display:flex;gap:16px;margin-top:38px;flex-wrap:wrap;}
.btn{
  font-family:var(--util);font-size:13px;letter-spacing:.08em;text-transform:uppercase;
  padding:15px 28px;position:relative;display:inline-flex;align-items:center;gap:10px;
  transition:transform .2s;
}
.btn-solid{background:var(--gold-500);color:var(--navy-950);}
.btn-solid:hover{background:var(--gold-400);}
.btn-line{border:1px solid var(--line-strong);color:var(--ink-100);}
.btn-line:hover{border-color:var(--gold-500);color:var(--gold-500);}

.hero-photo-wrap{position:relative;display:flex;justify-content:center;}
.hero-ring{
  position:absolute;width:110%;height:110%;border:1px dashed var(--line-strong);border-radius:50%;
  animation:spin 26s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}
.hero-photo{
  width:min(320px,80%);aspect-ratio:342/396;object-fit:cover;
  border:2px solid var(--gold-500);position:relative;z-index:2;
  box-shadow:0 30px 60px rgba(0,0,0,.5);
}
.float-icon{
  position:absolute;background:var(--navy-800);border:1px solid var(--line);
  padding:10px 14px;font-family:var(--util);font-size:12px;letter-spacing:.05em;
  display:flex;align-items:center;gap:8px;animation:floaty 5s ease-in-out infinite;z-index:3;
}
.float-icon svg{width:16px;height:16px;stroke:var(--gold-500);}
.fi-1{top:6%;left:-6%;animation-delay:.2s;}
.fi-2{bottom:14%;right:-10%;animation-delay:1.1s;}
.fi-3{bottom:-4%;left:8%;animation-delay:2s;}
@keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-14px);}}
.scroll-cue{
  position:absolute;bottom:34px;left:32px;display:flex;align-items:center;gap:12px;
  font-family:var(--util);font-size:11px;letter-spacing:.2em;color:var(--ink-500);text-transform:uppercase;
}
.scroll-cue .line{width:32px;height:1px;background:var(--ink-500);position:relative;overflow:hidden;}
.scroll-cue .line i{position:absolute;left:-100%;top:0;width:100%;height:100%;background:var(--gold-500);animation:cue 1.8s ease-in-out infinite;}
@keyframes cue{0%{left:-100%;}50%{left:0;}100%{left:100%;}}

/* ============ REVEAL UTILITY ============ */
.reveal{opacity:0;transform:translateY(36px);transition:opacity .8s ease, transform .8s ease;}
.reveal.in{opacity:1;transform:translateY(0);}
.reveal-l{opacity:0;transform:translateX(-36px);transition:opacity .8s ease, transform .8s ease;}
.reveal-l.in{opacity:1;transform:translateX(0);}
.reveal-r{opacity:0;transform:translateX(36px);transition:opacity .8s ease, transform .8s ease;}
.reveal-r.in{opacity:1;transform:translateX(0);}
.stagger.in > *{opacity:1;transform:translateY(0);}
.stagger > *{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease;}
.stagger.in > *:nth-child(1){transition-delay:.05s;}
.stagger.in > *:nth-child(2){transition-delay:.15s;}
.stagger.in > *:nth-child(3){transition-delay:.25s;}
.stagger.in > *:nth-child(4){transition-delay:.35s;}
.stagger.in > *:nth-child(5){transition-delay:.45s;}
.stagger.in > *:nth-child(6){transition-delay:.55s;}

/* ============ ABOUT ============ */
#about{background:var(--navy-900);}
.about-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:70px;align-items:start;}
@media (max-width:860px){ .about-grid{grid-template-columns:1fr;} }
.about-photo{position:relative;}
.about-photo img{border:2px solid var(--gold-500);filter:grayscale(.15);}
.about-photo .tag{
  position:absolute;bottom:-18px;right:-18px;background:var(--gold-500);color:var(--navy-950);
  font-family:var(--util);font-weight:700;font-size:12px;letter-spacing:.06em;text-transform:uppercase;
  padding:14px 18px;
}
.about-text p{color:var(--ink-300);line-height:1.85;font-size:16px;margin-bottom:18px;}
.about-text strong{color:var(--ink-100);}
.quick-facts{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:32px;}
.qf{border-top:1px solid var(--line);padding-top:14px;}
.qf b{font-family:var(--util);color:var(--gold-500);font-size:12px;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:6px;}
.qf span{color:var(--ink-300);font-size:14.5px;}

/* ============ SKILLS ============ */
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:60px;}
@media (max-width:860px){ .skills-grid{grid-template-columns:1fr;gap:40px;} }
.skill-col h3{font-family:var(--util);font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-500);margin-bottom:24px;}
.skill-row{margin-bottom:20px;}
.skill-row .lbl{display:flex;justify-content:space-between;font-size:14px;color:var(--ink-100);margin-bottom:8px;}
.skill-row .lbl span:last-child{color:var(--ink-500);font-family:var(--util);font-size:12.5px;}
.bar{height:2px;background:var(--navy-700);position:relative;overflow:hidden;}
.bar i{position:absolute;left:0;top:0;height:100%;width:0%;background:linear-gradient(90deg,var(--gold-700),var(--gold-500));transition:width 1.4s cubic-bezier(.2,.8,.2,1);}
.softwares{display:flex;gap:16px;flex-wrap:wrap;margin-top:70px;}
.soft-card{
  border:1px solid var(--line);padding:20px 26px;text-align:center;min-width:110px;
  transition:transform .3s,border-color .3s,background .3s;
}
.soft-card:hover{transform:translateY(-8px);border-color:var(--gold-500);background:var(--navy-800);}
.soft-card .ic{
  font-family:var(--disp);font-size:22px;margin-bottom:10px;width:52px;height:52px;
  display:flex;align-items:center;justify-content:center;border-radius:6px;margin-left:auto;margin-right:auto;
  letter-spacing:.02em;
}
.soft-card span{display:block;font-family:var(--util);font-size:11.5px;letter-spacing:.06em;color:var(--ink-300);text-transform:uppercase;}
.ic-ai{background:#1a0d00;color:#FF9A00;border:1px solid #FF9A00;}
.ic-ps{background:#001d33;color:#31A8FF;border:1px solid #31A8FF;}
.ic-id{background:#2b000f;color:#FF3366;border:1px solid #FF3366;}
.ic-canva{background:linear-gradient(135deg,#00C4CC,#7D2AE8);color:#fff;border:1px solid transparent;}
.ic-lr{background:#001a33;color:#31C5F4;border:1px solid #31C5F4;}
.ic-office{background:var(--navy-950);border:1px solid var(--line-strong);display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:3px;padding:9px;}
.ic-office i{border-radius:1px;}
.ic-office i:nth-child(1){background:#D24726;}
.ic-office i:nth-child(2){background:#33854F;}
.ic-office i:nth-child(3){background:#EB9C00;}
.ic-office i:nth-child(4){background:#2B579A;}

/* ============ SERVICES ============ */
#services{background:var(--navy-900);}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:60px;}
@media (max-width:860px){ .services-grid{grid-template-columns:1fr;} }
.serv-card{
  background:var(--navy-900);padding:44px 34px;position:relative;overflow:hidden;
  transition:background .3s;
}
.serv-card:hover{background:var(--navy-800);}
.serv-card .num{font-family:var(--util);font-size:12px;color:var(--ink-500);letter-spacing:.1em;}
.serv-card svg{width:30px;height:30px;stroke:var(--gold-500);margin:20px 0 18px;transition:transform .35s;}
.serv-card:hover svg{transform:translateY(-4px) rotate(-4deg);}
.serv-card h4{font-family:var(--util);font-size:18px;margin-bottom:10px;text-transform:uppercase;letter-spacing:.02em;}
.serv-card p{color:var(--ink-500);font-size:14px;line-height:1.6;}

/* ============ PORTFOLIO ============ */
.project-card{
  border:1px solid var(--line);margin-bottom:28px;overflow:hidden;
}
.project-head{
  display:grid;grid-template-columns:.9fr 1.1fr;
}
@media (max-width:860px){ .project-head{grid-template-columns:1fr;} }
.project-visual{
  background:var(--navy-800);position:relative;min-height:280px;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.project-visual .mono{
  font-family:var(--disp);font-size:100px;color:rgba(240,169,59,.14);letter-spacing:.02em;
}
.project-visual .badge-year{
  position:absolute;top:20px;left:20px;font-family:var(--util);font-size:11px;
  letter-spacing:.15em;color:var(--gold-500);border:1px solid var(--line-strong);padding:6px 12px;
}
.project-info{padding:44px;}
.project-info .cat{font-family:var(--util);font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-500);margin-bottom:14px;}
.project-info h3{font-family:var(--disp);font-size:clamp(26px,3vw,36px);text-transform:uppercase;margin-bottom:16px;}
.project-info p{color:var(--ink-300);line-height:1.75;font-size:15px;margin-bottom:22px;}
.tool-tags{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px;}
.tool-tags span{font-family:var(--util);font-size:11.5px;letter-spacing:.05em;color:var(--ink-300);border:1px solid var(--line);padding:6px 12px;}
.project-cta{font-family:var(--util);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-500);display:inline-flex;align-items:center;gap:8px;cursor:pointer;}
.project-cta svg{width:14px;height:14px;transition:transform .25s;}
.project-cta:hover svg{transform:translateX(5px);}

.project-detail{
  max-height:0;overflow:hidden;transition:max-height .6s ease;border-top:1px solid var(--line);
}
.project-detail.open{max-height:20000px;}
.detail-inner{padding:40px 44px;}
.detail-inner h5{font-family:var(--util);font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-500);margin:26px 0 14px;}
.detail-inner h5:first-child{margin-top:0;}
.palette{display:flex;gap:10px;flex-wrap:wrap;}
.swatch{width:64px;height:64px;display:flex;align-items:flex-end;padding:6px;font-family:var(--util);font-size:9.5px;color:rgba(255,255,255,.75);}
.type-sample{display:flex;gap:30px;flex-wrap:wrap;}
.type-sample div span{display:block;}
.mock-frames{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;}
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;}
.gallery-grid figure{margin:0;border:1px solid var(--line);overflow:hidden;background:var(--navy-950);}
.gallery-grid img{width:100%;height:180px;object-fit:cover;display:block;transition:transform .4s ease;}
.gallery-grid figure:hover img{transform:scale(1.06);}
.gallery-grid figcaption{
  font-family:var(--util);font-size:11px;letter-spacing:.05em;color:var(--ink-500);
  padding:8px 10px;text-transform:uppercase;border-top:1px solid var(--line);
}
.project-visual img.thumb{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5;}
.project-visual img.thumb-logo{
  position:relative;inset:auto;width:62%;height:auto;object-fit:contain;opacity:1;
  filter:drop-shadow(0 8px 24px rgba(0,0,0,.5));
}
.project-visual{background:var(--navy-800) center/cover;}
.mock-frame{
  border:1px dashed var(--line-strong);padding:20px 12px;text-align:center;color:var(--ink-500);
  font-family:var(--util);font-size:11.5px;letter-spacing:.04em;min-height:90px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
}
.mock-frame svg{width:20px;height:20px;stroke:var(--ink-500);}
.detail-note{margin-top:20px;font-size:13px;color:var(--ink-500);font-style:italic;}

.ppt-viewer{user-select:none;-webkit-user-select:none;}
.ppt-stage{
  position:relative;background:var(--navy-950);border:1px solid var(--line);
  aspect-ratio:16/9;overflow:hidden;display:flex;align-items:center;justify-content:center;
}
.ppt-stage img{width:100%;height:100%;object-fit:contain;pointer-events:none;-webkit-user-drag:none;}
.ppt-shield{position:absolute;inset:0;z-index:2;background:transparent;}
.ppt-controls{display:flex;align-items:center;justify-content:center;gap:22px;margin-top:16px;}
.ppt-btn{
  width:40px;height:40px;border:1px solid var(--line-strong);display:flex;align-items:center;justify-content:center;
  color:var(--gold-500);transition:border-color .25s,transform .2s;background:transparent;cursor:pointer;
}
.ppt-btn:hover{border-color:var(--gold-500);transform:scale(1.06);}
.ppt-btn svg{width:16px;height:16px;}
.ppt-counter{font-family:var(--util);font-size:13px;letter-spacing:.1em;color:var(--ink-300);min-width:60px;text-align:center;}

/* ============ EXPERIENCE ============ */
#experience{background:var(--navy-900);}
.timeline{position:relative;margin-top:60px;padding-left:34px;border-left:1px solid var(--line);}
.tl-item{position:relative;padding-bottom:52px;}
.tl-item:last-child{padding-bottom:0;}
.tl-item::before{
  content:"";position:absolute;left:-40px;top:4px;width:11px;height:11px;border-radius:50%;
  background:var(--navy-950);border:2px solid var(--gold-500);
}
.tl-item.food::before{background:var(--gold-500);}
.tl-date{font-family:var(--util);font-size:12px;letter-spacing:.15em;color:var(--gold-500);text-transform:uppercase;margin-bottom:8px;}
.tl-item h4{font-family:var(--util);font-size:19px;margin-bottom:4px;}
.tl-item .place{color:var(--ink-500);font-size:13.5px;margin-bottom:12px;}
.tl-item ul{padding-left:18px;color:var(--ink-300);font-size:14.5px;line-height:1.8;}
.tl-tag{display:inline-block;margin-left:12px;font-family:var(--util);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:var(--gold-500);color:var(--navy-950);padding:3px 9px;vertical-align:middle;}

/* ============ EDUCATION ============ */
.edu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:60px;}
@media (max-width:860px){ .edu-grid{grid-template-columns:1fr;} }
.edu-card{background:var(--navy-950);padding:36px 30px;}
.edu-card .yr{font-family:var(--util);font-size:12px;color:var(--gold-500);letter-spacing:.1em;margin-bottom:14px;}
.edu-card h4{font-family:var(--util);font-size:16.5px;text-transform:uppercase;margin-bottom:8px;line-height:1.3;}
.edu-card p{color:var(--ink-500);font-size:13.5px;line-height:1.6;}

/* ============ STATS ============ */
#stats{background:var(--navy-800);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);text-align:center;}
@media (max-width:700px){ .stats-grid{grid-template-columns:1fr 1fr;gap:40px 0;} }
.stat b{font-family:var(--disp);font-size:clamp(38px,5vw,64px);color:var(--gold-500);display:block;font-weight:400;}
.stat span{font-family:var(--util);font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-300);}

/* ============ CONTACT ============ */
.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;margin-top:60px;}
@media (max-width:860px){ .contact-grid{grid-template-columns:1fr;} }
.contact-item{display:flex;gap:16px;align-items:flex-start;margin-bottom:26px;}
.contact-item svg{width:20px;height:20px;stroke:var(--gold-500);flex-shrink:0;margin-top:2px;}
.contact-item b{display:block;font-family:var(--util);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-500);margin-bottom:4px;}
.contact-item span, .contact-item a{color:var(--ink-100);font-size:15px;}
.contact-item a:hover{color:var(--gold-500);}
form{display:flex;flex-direction:column;gap:22px;}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
@media (max-width:600px){ .f-row{grid-template-columns:1fr;} }
.field{position:relative;}
.field input, .field textarea{
  width:100%;background:transparent;border:none;border-bottom:1px solid var(--line-strong);
  padding:12px 0;color:var(--ink-100);font-family:var(--body);font-size:15px;outline:none;
  transition:border-color .3s;
}
.field textarea{resize:none;height:100px;}
.field input:focus, .field textarea:focus{border-color:var(--gold-500);}
.field label{
  position:absolute;left:0;top:12px;color:var(--ink-500);font-size:15px;pointer-events:none;transition:.25s;
}
.field input:focus + label, .field input:not(:placeholder-shown) + label,
.field textarea:focus + label, .field textarea:not(:placeholder-shown) + label{
  top:-14px;font-size:11px;letter-spacing:.1em;color:var(--gold-500);text-transform:uppercase;
}
.submit-btn{align-self:flex-start;margin-top:10px;}

/* ============ FOOTER ============ */
footer{background:var(--navy-950);border-top:1px solid var(--line);padding:50px 0 30px;}
.foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;}
.foot-links{display:flex;gap:28px;font-family:var(--util);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-300);flex-wrap:wrap;}
.foot-links a:hover{color:var(--gold-500);}
.foot-social{display:flex;gap:16px;}
.foot-social a{
  width:36px;height:36px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
  transition:border-color .25s,color .25s;
}
.foot-social a:hover{border-color:var(--gold-500);color:var(--gold-500);}
.foot-social svg{width:15px;height:15px;}
.foot-bottom{
  display:flex;justify-content:space-between;align-items:center;margin-top:36px;padding-top:24px;
  border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-500);flex-wrap:wrap;gap:14px;
}
#toTop{
  width:40px;height:40px;border:1px solid var(--line-strong);display:flex;align-items:center;justify-content:center;
  transition:transform .25s, border-color .25s;
}
#toTop:hover{transform:translateY(-4px);border-color:var(--gold-500);}
#toTop svg{width:14px;height:14px;stroke:var(--gold-500);}

/* magnetic wrapper */
.magnetic{will-change:transform;}

/* ===================================================================
   FUTURISTIC ANIMATION LAYER — added
=================================================================== */

/* Animated aurora background behind hero */
.aurora-bg{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none;}
.aurora-bg span{
  position:absolute;border-radius:50%;filter:blur(90px);opacity:.35;
  background:radial-gradient(circle, var(--gold-500), transparent 70%);
  animation:auroraMove 18s ease-in-out infinite;
}
.aurora-bg span:nth-child(1){width:480px;height:480px;top:-120px;left:-100px;animation-duration:22s;}
.aurora-bg span:nth-child(2){width:380px;height:380px;bottom:-140px;right:-80px;animation-duration:26s;animation-delay:-6s;background:radial-gradient(circle, var(--gold-700), transparent 70%);}
.aurora-bg span:nth-child(3){width:300px;height:300px;top:40%;left:60%;animation-duration:30s;animation-delay:-12s;}
@keyframes auroraMove{
  0%,100%{transform:translate(0,0) scale(1);}
  33%{transform:translate(60px,-40px) scale(1.15);}
  66%{transform:translate(-50px,50px) scale(.9);}
}

/* Particle canvas sitting behind hero content */
#particleCanvas{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.55;}

/* Glitch text effect (applied on demand via .glitch class) */
.glitch{position:relative;display:inline-block;}
.glitch::before,.glitch::after{
  content:attr(data-text);position:absolute;top:0;left:0;width:100%;height:100%;
  overflow:hidden;opacity:.85;
}
.glitch::before{
  color:var(--gold-400);transform:translate(-2px,0);
  animation:glitchTop 3.5s infinite linear alternate-reverse;
  clip-path:inset(0 0 55% 0);
}
.glitch::after{
  color:var(--gold-700);transform:translate(2px,0);
  animation:glitchBottom 3.5s infinite linear alternate-reverse;
  clip-path:inset(55% 0 0 0);
}
@keyframes glitchTop{
  0%{transform:translate(-2px,-1px);}20%{transform:translate(3px,1px);}40%{transform:translate(-1px,2px);}
  60%{transform:translate(2px,-2px);}80%{transform:translate(-3px,0);}100%{transform:translate(1px,1px);}
}
@keyframes glitchBottom{
  0%{transform:translate(2px,1px);}20%{transform:translate(-3px,-1px);}40%{transform:translate(1px,-2px);}
  60%{transform:translate(-2px,2px);}80%{transform:translate(3px,0);}100%{transform:translate(-1px,-1px);}
}

/* Animated gradient text sweep for hero title */
.grad-sweep{
  background-size:200% auto;
  animation:gradSweep 5s linear infinite;
}
@keyframes gradSweep{
  0%{background-position:0% center;}
  100%{background-position:200% center;}
}

/* Glowing animated conic border for project cards */
.project-card{position:relative;isolation:isolate;}
.project-card::before{
  content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;z-index:-1;
  background:conic-gradient(from var(--angle,0deg), transparent 0deg 300deg, var(--gold-500) 340deg, transparent 360deg);
  -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .4s ease;
  animation:spinBorder 4s linear infinite;
}
.project-card:hover::before{opacity:1;}
@property --angle{syntax:'<angle>';inherits:false;initial-value:0deg;}
@keyframes spinBorder{to{--angle:360deg;}}

/* 3D tilt wrapper */
.tilt-el{transform-style:preserve-3d;transition:transform .15s ease-out;will-change:transform;}

/* Magnetic buttons — subtle glow pulse on hover handled via JS translate */
.btn-solid,.btn-line,.nav-cta{position:relative;overflow:hidden;}
.btn-solid::after,.btn-line::after,.nav-cta::after{
  content:"";position:absolute;top:50%;left:50%;width:0;height:0;border-radius:50%;
  background:rgba(240,169,59,.35);transform:translate(-50%,-50%);
  transition:width .5s ease,height .5s ease,opacity .5s ease;opacity:0;
}
.btn-solid:active::after,.btn-line:active::after,.nav-cta:active::after{
  width:260px;height:260px;opacity:1;transition:width 0s,height 0s;
}

/* Scanline sweep across ppt-viewer + project-visual on hover */
.project-visual{position:relative;overflow:hidden;}
.project-visual::after{
  content:"";position:absolute;top:0;left:-150%;width:60%;height:100%;
  background:linear-gradient(100deg, transparent, rgba(240,169,59,.18), transparent);
  transition:left .9s ease;
}
.project-card:hover .project-visual::after{left:150%;}

/* Floating gold particles drifting up (decorative, injected via JS) */
.drift-particle{
  position:fixed;bottom:-10px;width:4px;height:4px;border-radius:50%;
  background:var(--gold-500);opacity:0;pointer-events:none;z-index:5;
  animation:driftUp linear forwards;
}
@keyframes driftUp{
  0%{opacity:0;transform:translateY(0) translateX(0);}
  10%{opacity:.8;}
  90%{opacity:.5;}
  100%{opacity:0;transform:translateY(-100vh) translateX(var(--drift-x,20px));}
}

/* Number counter pop for skill bars / stats */
.count-pop{animation:countPop .4s ease;}
@keyframes countPop{0%{transform:scale(1);}50%{transform:scale(1.15);color:var(--gold-400);}100%{transform:scale(1);}}

/* Holographic shimmer overlay for badges */
.badge-year{position:relative;overflow:hidden;}
.badge-year::after{
  content:"";position:absolute;top:0;left:-120%;width:50%;height:100%;
  background:linear-gradient(110deg, transparent, rgba(255,255,255,.55), transparent);
  animation:shimmer 3.2s ease-in-out infinite;
}
@keyframes shimmer{
  0%,15%{left:-120%;}
  50%{left:140%;}
  100%{left:140%;}
}

/* Smooth reveal upgrade — scale-fade instead of flat translate for a modern feel */
.reveal.in{animation:revealPop .8s cubic-bezier(.16,1,.3,1) both;}
@keyframes revealPop{
  0%{opacity:0;transform:translateY(36px) scale(.97);}
  100%{opacity:1;transform:translateY(0) scale(1);}
}

/* Section heading underline that grows on scroll into view */
.sec-eyebrow{position:relative;}
.sec-eyebrow::after{
  content:"";position:absolute;left:0;bottom:-6px;height:1px;width:0;background:var(--gold-500);
  transition:width 1s cubic-bezier(.16,1,.3,1);
}
.reveal.in .sec-eyebrow::after,.reveal-l.in .sec-eyebrow::after,.reveal-r.in .sec-eyebrow::after{width:34px;}

/* Pulsing glow ring around cursor when hovering interactive project elements */
#cursor-ring.pulse{animation:ringPulse 1.2s ease-in-out infinite;}
@keyframes ringPulse{
  0%,100%{box-shadow:0 0 0 0 rgba(240,169,59,.35);}
  50%{box-shadow:0 0 0 10px rgba(240,169,59,0);}
}

@media (max-width:900px){
  .aurora-bg,#particleCanvas,.project-card::before{display:none;}
}


/* ===================================================================
   FUTURISTIC ANIMATION LAYER 2 — added
=================================================================== */

/* Scroll progress bar */
#scrollProgress{
  position:fixed;top:0;left:0;height:3px;width:0%;z-index:9999;
  background:linear-gradient(90deg,var(--gold-700),var(--gold-500),var(--gold-400));
  box-shadow:0 0 12px rgba(240,169,59,.7);
  transition:width .1s linear;
}

/* Animated mesh grid background (subtle moving grid) */
.mesh-grid{
  position:fixed;inset:0;z-index:-3;pointer-events:none;opacity:.12;
  background-image:
    linear-gradient(var(--line-strong) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-strong) 1px, transparent 1px);
  background-size:46px 46px;
  animation:meshDrift 40s linear infinite;
}
@keyframes meshDrift{
  0%{background-position:0 0, 0 0;}
  100%{background-position:400px 400px, 400px 400px;}
}

/* Neon pulsing glow on section headings */
.neon-pulse{
  animation:neonPulse 2.6s ease-in-out infinite;
}
@keyframes neonPulse{
  0%,100%{text-shadow:0 0 6px rgba(240,169,59,.15), 0 0 14px rgba(240,169,59,.05);}
  50%{text-shadow:0 0 14px rgba(240,169,59,.45), 0 0 28px rgba(240,169,59,.2);}
}

/* Per-letter text reveal spans */
.letter-reveal span{
  display:inline-block;opacity:0;transform:translateY(.6em) rotateX(-40deg);
  transition:opacity .5s ease, transform .5s ease;
}
.letter-reveal.in span{opacity:1;transform:translateY(0) rotateX(0);}

/* Click ripple effect */
.ripple-wave{
  position:absolute;border-radius:50%;pointer-events:none;
  background:rgba(240,169,59,.45);
  transform:translate(-50%,-50%) scale(0);
  animation:rippleAnim .65s ease-out forwards;
}
@keyframes rippleAnim{
  to{transform:translate(-50%,-50%) scale(1);opacity:0;}
}

/* Image mask sweep reveal for gallery/project images entering viewport */
.mask-reveal{position:relative;overflow:hidden;}
.mask-reveal::before{
  content:"";position:absolute;inset:0;background:var(--navy-950);z-index:2;
  transform:scaleX(1);transform-origin:right;
  transition:transform .9s cubic-bezier(.77,0,.18,1);
}
.mask-reveal.in::before{transform:scaleX(0);}

/* Morphing blob shape (organic animated border radius) */
.morph-blob{
  animation:morphShape 9s ease-in-out infinite;
}
@keyframes morphShape{
  0%,100%{border-radius:42% 58% 63% 37% / 41% 45% 55% 59%;}
  25%{border-radius:63% 37% 41% 59% / 55% 41% 59% 45%;}
  50%{border-radius:37% 63% 55% 45% / 63% 37% 41% 59%;}
  75%{border-radius:55% 45% 37% 63% / 41% 59% 45% 55%;}
}

/* Navbar dynamic blur/shrink on scroll (class toggled via JS) */
header.nav-scrolled, .nav-wrap.nav-scrolled{
  backdrop-filter:blur(14px) saturate(140%);
  background:rgba(6,10,20,.72) !important;
  box-shadow:0 8px 30px rgba(0,0,0,.35);
}

/* Animated SVG line-draw underline for eyebrows */
.draw-line{
  stroke-dasharray:120;stroke-dashoffset:120;
  animation:drawLine 1.4s ease forwards;
}
@keyframes drawLine{to{stroke-dashoffset:0;}}

/* Loading spark burst on button click */
.spark{
  position:absolute;width:4px;height:4px;border-radius:50%;background:var(--gold-400);
  pointer-events:none;animation:sparkFly .6s ease-out forwards;
}
@keyframes sparkFly{
  to{transform:translate(var(--sx,20px), var(--sy,-20px)) scale(0);opacity:0;}
}

/* Subtle breathing scale on badge/year + cta icons */
.breathe{animation:breathe 3.4s ease-in-out infinite;}
@keyframes breathe{0%,100%{transform:scale(1);}50%{transform:scale(1.06);}}

/* Gold scan-line sweeping vertically over full sections on scroll-enter */
.scan-enter{position:relative;overflow:hidden;}
.scan-enter::after{
  content:"";position:absolute;left:0;top:-100%;width:100%;height:40%;
  background:linear-gradient(180deg, transparent, rgba(240,169,59,.15), transparent);
  transition:top .9s ease;
}
.scan-enter.in::after{top:140%;}

/* Smooth cubic-bezier for everything already using .reveal (upgrade easing) */
.reveal, .reveal-l, .reveal-r{transition-timing-function:cubic-bezier(.16,1,.3,1);}

/* Tooltip-like floating label that follows tilt cards */
.tilt-el{transition:transform .12s ease-out, box-shadow .3s ease;}
.tilt-el:hover{box-shadow:0 20px 60px -20px rgba(240,169,59,.35);}

@media (max-width:900px){
  .mesh-grid,.morph-blob{display:none;}
}


/* ===================================================================
   MAXIMUM EFFECTS LAYER 3 — added
=================================================================== */

/* Twinkling star field */
.star{
  position:fixed;border-radius:50%;background:var(--gold-400);pointer-events:none;z-index:-1;
  animation:twinkle linear infinite;
}
@keyframes twinkle{
  0%,100%{opacity:.1;transform:scale(.6);}
  50%{opacity:1;transform:scale(1.3);}
}

/* Cursor trail dots */
.trail-dot{
  position:fixed;width:6px;height:6px;border-radius:50%;pointer-events:none;z-index:9998;
  background:var(--gold-500);opacity:.7;
  transition:opacity .5s ease;
}

/* Floating decorative icons drifting across the screen */
.float-icon-drift{
  position:fixed;pointer-events:none;z-index:-1;opacity:.14;color:var(--gold-500);
  animation:floatDrift linear infinite;
}
@keyframes floatDrift{
  0%{transform:translate(0,100vh) rotate(0deg);}
  100%{transform:translate(40px,-10vh) rotate(360deg);}
}

/* Typewriter caret */
.typewriter-caret{
  display:inline-block;width:2px;background:var(--gold-500);margin-left:2px;
  animation:caretBlink .8s steps(1) infinite;
}
@keyframes caretBlink{50%{opacity:0;}}

/* Permanent pulsing glow on primary buttons (not just hover) */
.btn-solid{
  animation:btnGlow 3s ease-in-out infinite;
}
@keyframes btnGlow{
  0%,100%{box-shadow:0 0 0 0 rgba(240,169,59,.0);}
  50%{box-shadow:0 0 22px 2px rgba(240,169,59,.35);}
}

/* Hue-rotating aurora for extra color life over long sessions */
.aurora-bg{animation:hueDrift 30s linear infinite;}
@keyframes hueDrift{
  0%{filter:hue-rotate(0deg);}
  100%{filter:hue-rotate(35deg);}
}

/* Equalizer decorative bars */
.eq-bars{display:inline-flex;align-items:flex-end;gap:3px;height:18px;vertical-align:middle;margin-left:8px;}
.eq-bars span{
  display:inline-block;width:3px;background:var(--gold-500);border-radius:2px;
  animation:eqBounce .9s ease-in-out infinite;
}
.eq-bars span:nth-child(1){animation-delay:0s;height:40%;}
.eq-bars span:nth-child(2){animation-delay:.15s;height:80%;}
.eq-bars span:nth-child(3){animation-delay:.3s;height:55%;}
.eq-bars span:nth-child(4){animation-delay:.45s;height:90%;}
@keyframes eqBounce{
  0%,100%{transform:scaleY(.4);}
  50%{transform:scaleY(1);}
}

/* Section wipe overlay transition on scroll */
.wipe-overlay{
  position:fixed;inset:0;z-index:9997;pointer-events:none;
  background:linear-gradient(90deg, var(--gold-500), transparent);
  transform:scaleX(0);transform-origin:left;opacity:0;
}
.wipe-overlay.play{
  animation:wipePlay .6s ease-out;
}
@keyframes wipePlay{
  0%{transform:scaleX(0);opacity:.5;}
  60%{transform:scaleX(1);opacity:.25;}
  100%{transform:scaleX(1);opacity:0;}
}

/* Confetti particle */
.confetti-piece{
  position:fixed;width:7px;height:11px;top:-20px;z-index:9996;pointer-events:none;
  animation:confettiFall linear forwards;
}
@keyframes confettiFall{
  to{transform:translateY(110vh) rotate(600deg);opacity:.2;}
}

/* Rainbow rotating border ring for hero portrait / avatar if present */
.hero-portrait, .avatar, .profile-img{position:relative;}
.hero-portrait::before, .avatar::before, .profile-img::before{
  content:"";position:absolute;inset:-6px;border-radius:inherit;z-index:-1;
  background:conic-gradient(from 0deg, var(--gold-700), var(--gold-400), var(--gold-700));
  animation:spinBorder 5s linear infinite;
  opacity:.6;
}

/* Extra intense hover lift for soft/service cards */
.soft-card, .serv-card{transition:transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s ease;}
.soft-card:hover, .serv-card:hover{
  transform:translateY(-10px) scale(1.02);
  box-shadow:0 30px 60px -25px rgba(240,169,59,.4);
}

/* Text shimmer for eyebrow labels */
.hero-eyebrow{
  background:linear-gradient(90deg, var(--ink-300) 0%, var(--gold-400) 50%, var(--ink-300) 100%);
  background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;
  animation:gradSweep 4s linear infinite;
}

@media (max-width:900px){
  .star, .float-icon-drift, .trail-dot{display:none;}
}

</style>
</head>
